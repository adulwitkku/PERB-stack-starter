{
  "name": "PERB stack app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"**/*.(tsx|ts)\"",
    "format:check": "prettier --check \"**/*.(tsx|ts)\"",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "android": "tauri android dev",
    "ios": "tauri ios dev 'iPhone 15'",
    "api:dev": "bun --hot server/standalone.ts",
    "api:build": "bun build server/standalone.ts --outdir dist --target=node",
    "api:start": "bun dist/standalone.js",
    "test:unit": "vitest run --reporter verbose",
    "test:unit:watch": "vitest --reporter verbose",
    "test:unit:coverage": "vitest run --reporter verbose --coverage",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "test": "vitest run --reporter verbose && bunx playwright test"
  },
  "dependencies": {
    "@daveyplate/better-auth-ui": "^3.3.15",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/eden": "^1.4.8",
    "@elysiajs/openapi": "^1.4.14",
    "@opennextjs/cloudflare": "^1.17.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.91.3",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/plugin-http": "^2.5.7",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.28",
    "lucide-react": "^0.555.0",
    "next": "16.2.0",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsyringe": "^4.10.0"
  },
  "overrides": {
    "@sinclair/typebox": "0.34.47"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "oxlint": "^1.56.0",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
